[Unit]
Description=telegent bridge — Telegram <-> universal-chat-agent
After=network-online.target telegent-brain.service
Wants=network-online.target telegent-brain.service

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/telegent/application/bridge
ExecStart=/home/deploy/telegent/application/bridge/.venv/bin/python -m application.main
Restart=on-failure
RestartSec=5
# Long-polling is one-instance-per-token; keep a single copy running.
MemoryMax=150M

[Install]
WantedBy=multi-user.target
