# /etc/sudoers.d/deploy-telegent
# Lets the deploy user manage the telegent services without a password.
# Mirrors deploy-invintiry. Install ONCE as root:
#   sudo cp deploy/telegent.sudoers /etc/sudoers.d/deploy-telegent
#   sudo chmod 440 /etc/sudoers.d/deploy-telegent
#   sudo visudo -cf /etc/sudoers.d/deploy-telegent
# (systemctl daemon-reload and /bin/cp are already granted by deploy-invintiry.)
#
# Both single-unit AND combined (brain+bridge in one call) forms are granted:
# sudo matches the FULL argument vector exactly, so `status brain bridge` does
# NOT match separate `status brain` / `status bridge` rules. The combined form
# mirrors invintiry (which grants `restart/enable/start api web`). Ops that pass
# both units at once (e.g. SETUP.md's `status telegent-brain telegent-bridge`)
# need the combined entry, or they fall through to a password prompt.
deploy ALL=(ALL) NOPASSWD: \
  /bin/systemctl start telegent-brain, \
  /bin/systemctl start telegent-bridge, \
  /bin/systemctl start telegent-brain telegent-bridge, \
  /bin/systemctl stop telegent-brain, \
  /bin/systemctl stop telegent-bridge, \
  /bin/systemctl stop telegent-brain telegent-bridge, \
  /bin/systemctl restart telegent-brain, \
  /bin/systemctl restart telegent-bridge, \
  /bin/systemctl restart telegent-brain telegent-bridge, \
  /bin/systemctl enable telegent-brain, \
  /bin/systemctl enable telegent-bridge, \
  /bin/systemctl enable telegent-brain telegent-bridge, \
  /bin/systemctl status telegent-brain, \
  /bin/systemctl status telegent-bridge, \
  /bin/systemctl status telegent-brain telegent-bridge
