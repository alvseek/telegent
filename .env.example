# Copy this file to `.env` and fill it in. NEVER commit `.env`.

# --- Telegram ---
# Bot token from @BotFather (see README for how to create a bot).
TELEGRAM_BOT_TOKEN=

# --- Model (OpenRouter, OpenAI-compatible) ---
# Your OpenRouter API key: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Model id on OpenRouter — swap to any model you like.
# Placeholder default below; set it to your preferred (e.g. your BRYES model).
OPENROUTER_MODEL=deepseek/deepseek-chat

# OpenAI-compatible base URL for OpenRouter (usually leave as-is).
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Behaviour ---
# How many recent messages (user + assistant) to remember per chat.
MEMORY_WINDOW=15

# Where the SQLite memory database lives.
DB_PATH=telegent.db

# The agent's persona / system prompt.
SYSTEM_PROMPT=You are telegent, a helpful, friendly assistant on Telegram. Be concise and clear.
