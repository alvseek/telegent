# Copy this file to `.env` and fill it in. NEVER commit `.env`.

# --- Telegram ---
# Bot token from @BotFather (see README for how to create a bot).
TELEGRAM_BOT_TOKEN=

# --- Brain (universal-chat-agent) ---
# Base URL of the running brain. The bridge POSTs /chat here.
#   local (both on host):    http://localhost:8000
#   bridge in Docker -> host: http://host.docker.internal:8000
#   both in one compose net:  http://universal-chat-agent:8000
BRAIN_URL=http://localhost:8000

# How long to wait for a brain reply, in seconds (LLM calls can be slow).
BRAIN_TIMEOUT=60

# --- Which agent this bot is ---
# One bridge = one bot token = one agent. Leave empty and the brain answers as its
# default agent; set an agent id the brain's memory service holds (e.g.
# invintiry-operator) and the brain awakens that agent and answers as it.
AGENT_ID=

# --- Who may talk to this bot ---
# Comma-separated Telegram chat ids (negative for groups). Empty = anyone. With a
# list, every other chat is dropped silently before the brain is called and logged
# at WARNING with its chat id (that log line is how you find an id to add).
ALLOWED_CHAT_IDS=

# Discard messages Telegram queued while the bridge was down, instead of replaying
# them on start (default true). A command sent hours ago should not run the moment
# the bot comes back; the sender simply re-sends.
DROP_PENDING_UPDATES=true

# --- WhatsApp transport (optional) ---
# Only the WhatsApp entry point reads these; the Telegram one ignores them, and
# both processes share this file. Leave the block out entirely and only the
# Telegram bridge can start.
#
# IMPORTANT: put comments on their OWN line, as they are here. python-dotenv
# ends an unquoted value at a whitespace-preceded '#', so a bare
#   WHATSAPP_ALLOWED_IDS=        # leave empty
# makes the comment itself the value, and the loader then refuses it.

# Permanent System User token from Meta (Business Settings -> Users -> System
# users -> Generate new token, with whatsapp_business_messaging). The temporary
# dashboard token expires in ~24h and is not usable here.
WHATSAPP_ACCESS_TOKEN=

# The sending number's id, from WhatsApp -> API Setup. Not the phone number.
WHATSAPP_PHONE_NUMBER_ID=

# App settings -> Basic -> App secret. Used to verify X-Hub-Signature-256 on
# every inbound webhook. Without it this endpoint would accept anything.
WHATSAPP_APP_SECRET=

# A string you invent. You paste the same one into Meta's webhook form; it is
# checked once, during the handshake, so each side knows it reached the other.
WHATSAPP_VERIFY_TOKEN=

# Comma-separated WhatsApp ids (a sender's number in international form, no
# plus). Empty = open, same meaning as ALLOWED_CHAT_IDS above.
WHATSAPP_ALLOWED_IDS=

# Where this process listens. Loopback by design: a reverse proxy terminates TLS
# for the public hostname and forwards here.
WHATSAPP_HOST=127.0.0.1
WHATSAPP_PORT=8200

# SQLite file recording message ids already answered. Meta redelivers a webhook
# it did not see acknowledged in time, and this is what stops a redelivery
# becoming a second reply.
WHATSAPP_DB_PATH=whatsapp.db

# Graph API version, pinned rather than floating: Meta's error shapes differ
# between versions and a silent move is hard to diagnose.
WHATSAPP_API_VERSION=v22.0
