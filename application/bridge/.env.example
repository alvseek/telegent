# Copy this file to `.env` and fill it in. NEVER commit `.env`.

# --- Telegram ---
# Bot token from @BotFather (see README for how to create a bot).
TELEGRAM_BOT_TOKEN=

# --- Brain (universal-chat-agent) ---
# Base URL of the running brain. The bridge POSTs /chat here.
#   local (both on host):    http://localhost:8000
#   bridge in Docker -> host: http://host.docker.internal:8000
#   both in one compose net:  http://universal-chat-agent:8000
BRAIN_URL=http://localhost:8000

# How long to wait for a brain reply, in seconds (LLM calls can be slow).
BRAIN_TIMEOUT=60

# --- Which agent this bot is ---
# One bridge = one bot token = one agent. Leave empty and the brain answers as its
# default agent; set an agent id the brain's memory service holds (e.g.
# invintiry-operator) and the brain awakens that agent and answers as it.
AGENT_ID=

# --- Who may talk to this bot ---
# Comma-separated Telegram chat ids (negative for groups). Empty = anyone. With a
# list, every other chat is dropped silently before the brain is called and logged
# at WARNING with its chat id (that log line is how you find an id to add).
ALLOWED_CHAT_IDS=

# Discard messages Telegram queued while the bridge was down, instead of replaying
# them on start (default true). A command sent hours ago should not run the moment
# the bot comes back; the sender simply re-sends.
DROP_PENDING_UPDATES=true
